# ═══════════════════════════════════════════════════════════════════════════
# MediSpark — Environment Variables
# Copy this file to .env and fill in your values.
# ═══════════════════════════════════════════════════════════════════════════

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1

# Server
HOST=0.0.0.0
PORT=5000

# MongoDB
MONGO_URI=mongodb://localhost:27017/medispark

# Redis (sessions + cache)
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=medispark-app

# Kafka topic names
TOPIC_SYMPTOM_INPUT=symptom-input
TOPIC_PREDICTION_RESULT=prediction-result
TOPIC_CHAT_MESSAGES=chat-messages
TOPIC_AUDIT_LOG=audit-log
TOPIC_ALERT_HIGH_RISK=alert-high-risk
TOPIC_RETRAIN_TRIGGER=retrain-trigger

# ML
MODEL_PATH=models/disease_classifier.pkl
SYMPTOM_INDEX_PATH=models/symptom_index.json

# PostgreSQL
POSTGRES_URI=postgresql://medispark:medispark@localhost:5432/medispark

# JWT (defaults to SECRET_KEY if not set)
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRES=3600
JWT_REFRESH_EXPIRES=604800

# LLM keys (optional — chatbot works without them via rule-based fallback)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Ollama — local default; replace with Colab ngrok URL when using GPU tunnel
# See colab_llm_server.ipynb for setup. Recommended model: llama3.2:3b or mistral:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# Week 3 — Batch & Continuous Learning
BATCH_INTERVAL_HOURS=6
MODEL_AB_THRESHOLD=2.0
MIN_RETRAIN_SAMPLES=50
